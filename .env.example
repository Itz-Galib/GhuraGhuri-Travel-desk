# Copy to .env and fill in. Never commit real values.
# Generated by `neon deploy` into .env.local; this file is the documented contract.

APP_NAME="GhuraGhuri Travel Desk API"
ENVIRONMENT=local
DEBUG=false
API_V1_PREFIX=/api/v1

# `neon deploy` writes the pooled and direct URLs into .env.local automatically.
# DATABASE_URL = pooled (app), DATABASE_URL_UNPOOLED = direct (Alembic).
# Local docker-compose fallback:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tourdesk
DATABASE_URL_UNPOOLED=postgresql+psycopg://postgres:postgres@localhost:5432/tourdesk
# Optional alias; takes precedence over DATABASE_URL_UNPOOLED when set.
DATABASE_URL_DIRECT=
SQL_ECHO=false

# auth (T1) - generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_DOMAIN=

# comma-separated allow-list
CORS_ORIGINS=http://localhost:5173

BOOKING_HOLD_MINUTES=30

# operator verification (T2) - separate keys, never reuse
NID_ENCRYPTION_KEY=
NID_HASH_KEY=

# object storage (T2)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BUCKET=
STORAGE_PRIVATE_BUCKET=

# frontend (frontend/.env.local)
VITE_API_URL=http://localhost:8000
